# OnMixAI backend configuration — copy to `.env` and fill in real values.
# Every variable consumed by src/shared/config.py::Settings is listed here.
# `.env` itself is gitignored; this template is the documented source of truth.

# Deployment environment. One of: dev | test | prod.
ENV=dev

# Async SQLAlchemy DSN for the application runtime. Uses the non-superuser,
# non-bypassrls runtime role (onmixai_app) so Postgres RLS is always enforced.
# Must use the asyncpg driver. Host port 5440 matches infra/docker-compose.yml's
# published Postgres port (5432 is commonly occupied by a native install);
# inside the compose network the API reaches Postgres at postgres:5432.
DATABASE_URL=postgresql+asyncpg://onmixai_app:onmixai_app@localhost:5440/onmixai

# Migration-owner DSN (elevated role) used ONLY by Alembic — it creates
# extensions, RLS policies, and grants. Kept separate from DATABASE_URL so the
# runtime role can never bypass RLS (CLAUDE.md §4). Read by alembic/env.py.
MIGRATION_DATABASE_URL=postgresql+asyncpg://onmixai:onmixai@localhost:5440/onmixai

# Retention purge DSN (Task 7 / ADR 0019). A DEDICATED, least-privilege purger role —
# NOT the runtime role and NOT bypassrls — granted DELETE on audit_events + the
# conversation tables by migration 0010. The retention worker uses ONLY this connection
# to delete expired data; the runtime role's audit DELETE stays REVOKEd (immutability).
# Leave unset to disable purging (the job then fails loud rather than silently skipping).
PURGE_DATABASE_URL=postgresql+asyncpg://onmixai_purge:onmixai_purge@localhost:5440/onmixai
# Retention purge runs dry by default (reports candidates, deletes nothing). Flip to false
# only once the dry-run output has been reviewed. Batch size bounds each committed delete.
RETENTION_DRY_RUN=true
RETENTION_BATCH_SIZE=500

# Secret used to sign JWT access tokens. MUST be at least 32 characters.
# Generate a real one with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=dev-only-insecure-secret-change-me-32+chars
JWT_ALGORITHM=HS256

# Token lifetimes (seconds). Defaults: access 15 min, refresh 14 days.
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=1209600

# Logging level: DEBUG | INFO | WARNING | ERROR.
LOG_LEVEL=INFO

# Database connection pool tuning.
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=5
DB_POOL_TIMEOUT_SECONDS=30

# Object storage (S3-compatible / MinIO in dev). Host port 9110 matches the
# published MinIO API port in infra/docker-compose.yml; inside the compose
# network the API/worker reach it at http://minio:9000.
STORAGE_ENDPOINT=http://localhost:9110
STORAGE_ACCESS_KEY=onmixai
STORAGE_SECRET_KEY=onmixai-dev-secret-key
STORAGE_BUCKET=onmixai

# Ingestion queue (Redis / ARQ broker). Host port 6390 matches docker-compose;
# inside the compose network use redis://redis:6379/0.
REDIS_URL=redis://localhost:6390/0

# Ingestion limits / tuning (max_* and ingest_* have defaults; dimension is required).
MAX_UPLOAD_BYTES=52428800
MAX_DOCUMENT_PAGES=2000
# Vector dimension — the single source of truth; migration 0002 sizes the column
# from this. Must match the embedding model in use (1536 = OpenAI text-embedding-3-small).
EMBEDDING_DIMENSION=1536
EMBEDDING_BATCH_SIZE=100
INGEST_MAX_ATTEMPTS=3
INGEST_STUCK_AFTER_SECONDS=1800

# Azure OpenAI (Celanese's stack). Optional — required only when an `azure/<logical>` model
# ref appears in LLM_DEFAULT_MODEL or LLM_FALLBACK_CHAIN, in which case ALL of endpoint/version/
# key must be set (fail-fast otherwise). AZURE_DEPLOYMENT_MAP maps a logical model name to the
# Azure deployment name (JSON object). Azure-ready: verify against your deployment with
# `python scripts/azure_smoke.py` — the app never assumes a live Azure endpoint.
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com
AZURE_OPENAI_API_VERSION=2024-06-01
AZURE_OPENAI_API_KEY=your-azure-openai-key
AZURE_DEPLOYMENT_MAP={"gpt-4o-mini": "your-deployment-name"}
